generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LibraryStatus {
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

enum NotificationType {
  BOOKING
  COMPLAINT
  FEE_REMINDER
  ANNOUNCEMENT
  MEMBERSHIP
  SYSTEM
}

enum ComplaintStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum LibraryImageType {
  EXTERIOR
  STUDY_HALL
  SEAT
  FACILITIES
  OTHER
}

enum CommunityReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum CommunityConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CommunityChannelType {
  GLOBAL
  LIBRARY
  DIRECT
}

enum CommunityMessageType {
  TEXT
  VACANCY
  CURRENT_AFFAIRS
  EXAM_UPDATE
  NOTE
  FILE
}

enum GroupBookingStatus {
  INVITING
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  phone                 String?                @unique
  passwordHash          String
  role                  Role                   @default(STUDENT)
  status                UserStatus             @default(ACTIVE)
  isPro                 Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  libraries             Library[]              @relation("LibraryOwner")
  memberships           StudentMembership[]
  bookings              Booking[]
  reviews               Review[]
  notifications         Notification[]
  studySessions         StudySession[]
  studyStreak           StudyStreak?
  favorites             Favorite[]
  tasks                 Task[]
  complaints            Complaint[]
  ledGroups             GroupBooking[]         @relation("GroupLeader")
  groupMemberships      GroupBookingMember[]
  passwordResets        PasswordResetToken[]
  notificationPrefs     UserNotificationPrefs?
  communityMemberships  CommunityChannelMember[]
  communityMessages     CommunityMessage[]
  communityReactions    CommunityMessageReaction[]
  communityReports      CommunityReport[]      @relation("CommunityReporter")
  sentConnections       CommunityConnection[]   @relation("ConnectionRequester")
  receivedConnections   CommunityConnection[]   @relation("ConnectionReceiver")
  blockedUsers          UserBlock[]            @relation("Blocker")
  blockedBy             UserBlock[]            @relation("Blocked")
  mutedUsers            UserMute[]             @relation("Muter")
  mutedBy               UserMute[]             @relation("Muted")
}

model Library {
  id             String              @id @default(cuid())
  ownerId        String?
  owner          User?               @relation("LibraryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  slug           String              @unique
  description    String
  address        String
  area           String
  city           String
  state          String
  pincode        String?
  phone          String
  whatsapp       String?
  timings        String
  capacity       Int?
  latitude       Float?
  longitude      Float?
  facilities     Json
  pricing        Json
  status         LibraryStatus       @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  images         LibraryImage[]
  seats          Seat[]
  memberships    StudentMembership[]
  bookings       Booking[]
  reviews        Review[]
  announcements  Announcement[]
  favorites      Favorite[]
  complaints     Complaint[]
  groupBookings  GroupBooking[]
  communityChannels CommunityChannel[]

  @@index([city, status])
}

model LibraryImage {
  id         String   @id @default(cuid())
  libraryId  String
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  url        String
  publicId   String?
  type       LibraryImageType @default(OTHER)
  alt        String?
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Seat {
  id            String              @id @default(cuid())
  libraryId     String
  library       Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  number        String
  type          String?
  isAvailable   Boolean             @default(true)
  memberships   StudentMembership[]

  @@unique([libraryId, number])
}

model StudentMembership {
  id          String           @id @default(cuid())
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  libraryId   String
  library     Library          @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  seatId      String?
  seat        Seat?            @relation(fields: [seatId], references: [id], onDelete: SetNull)
  startDate   DateTime
  endDate     DateTime?
  monthlyFee  Int
  status      MembershipStatus @default(ACTIVE)
  attendances Attendance[]
  payments    Payment[]
  createdAt   DateTime         @default(now())

  @@index([libraryId, status])
  @@index([seatId])
  @@unique([studentId, libraryId])
}

model Booking {
  id         String        @id @default(cuid())
  studentId  String
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  libraryId  String
  library    Library       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  planName   String?
  message    String?
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([libraryId, status])
  @@index([studentId, libraryId, status])
}

model Review {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  libraryId  String
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([studentId, libraryId])
}

model Attendance {
  id            String              @id @default(cuid())
  membershipId  String
  membership    StudentMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date          DateTime
  status        AttendanceStatus    @default(PRESENT)
  checkIn       DateTime?
  checkOut      DateTime?

  @@unique([membershipId, date])
}

model Payment {
  id            String              @id @default(cuid())
  membershipId  String
  membership    StudentMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  amount        Int
  dueDate       DateTime
  paidAt        DateTime?
  status        PaymentStatus       @default(PENDING)
  note          String?
  createdAt     DateTime            @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType @default(SYSTEM)
  title      String
  message    String
  entityId   String?
  actionPath String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model Announcement {
  id         String   @id @default(cuid())
  libraryId  String
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  title      String
  message    String
  createdAt  DateTime @default(now())
}

model StudySession {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  durationMin Int
  mode        String   @default("FOCUS")
  startedAt   DateTime
  endedAt     DateTime
  createdAt   DateTime @default(now())
}

model StudyStreak {
  id             String   @id @default(cuid())
  studentId      String   @unique
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentDays    Int      @default(0)
  longestDays    Int      @default(0)
  lastStudyDate  DateTime?
  updatedAt      DateTime @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  libraryId  String
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, libraryId])
}

model Task {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  taskDate    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, taskDate])
}

model Complaint {
  id          String          @id @default(cuid())
  studentId   String
  student     User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  libraryId   String
  library     Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  title       String          @default("Issue report")
  category    String
  description String
  status      ComplaintStatus @default(PENDING)
  ownerReply  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([libraryId, status])
}

model GroupBooking {
  id           String             @id @default(cuid())
  leaderId     String
  leader       User               @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  libraryId    String
  library      Library            @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  name         String
  groupSize    Int
  planName     String?
  status       GroupBookingStatus @default(INVITING)
  seatNumbers  Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      GroupBookingMember[]

  @@index([libraryId, status])
}

model GroupBookingMember {
  id             String       @id @default(cuid())
  groupBookingId String
  groupBooking   GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  email          String
  accepted       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([groupBookingId, email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([token, expiresAt])
}

model UserNotificationPrefs {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcements   Boolean  @default(true)
  bookingUpdates  Boolean  @default(true)
  complaintUpdates Boolean @default(true)
  membershipReminders Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CommunityChannel {
  id          String                  @id @default(cuid())
  type        CommunityChannelType
  name        String
  description String?
  libraryId   String?
  library     Library?                @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  members     CommunityChannelMember[]
  messages    CommunityMessage[]

  @@index([type, libraryId])
}

model CommunityChannelMember {
  id          String           @id @default(cuid())
  channelId   String
  channel     CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRemoved   Boolean          @default(false)
  isBanned    Boolean          @default(false)
  lastReadAt  DateTime?
  createdAt   DateTime         @default(now())

  @@unique([channelId, userId])
  @@index([userId, isRemoved, isBanned])
}

model CommunityMessage {
  id          String                   @id @default(cuid())
  channelId   String
  channel     CommunityChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyToId   String?
  replyTo     CommunityMessage?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     CommunityMessage[]       @relation("MessageReplies")
  type        CommunityMessageType     @default(TEXT)
  body        String?
  attachmentUrl String?
  attachmentName String?
  attachmentMime String?
  isDeleted   Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  reactions   CommunityMessageReaction[]
  reports     CommunityReport[]

  @@index([channelId, createdAt])
  @@index([senderId, createdAt])
}

model CommunityMessageReaction {
  id        String           @id @default(cuid())
  messageId String
  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime         @default(now())

  @@unique([messageId, userId, emoji])
}

model CommunityReport {
  id         String                 @id @default(cuid())
  reporterId String
  reporter   User                   @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  messageId  String?
  message    CommunityMessage?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reason     String
  status     CommunityReportStatus  @default(OPEN)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([status, createdAt])
}

model CommunityConnection {
  id          String                    @id @default(cuid())
  requesterId String
  requester   User                      @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                      @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      CommunityConnectionStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserMute {
  id        String   @id @default(cuid())
  muterId   String
  muter     User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId   String
  muted     User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
}
